# Per-worktree environment overrides for `make air` and CLI tools.
# Copy to `.env` (gitignored) and adjust per worktree to avoid port/DB
# collisions between sibling worktrees.

# Server port (consumed by .air.toml via ${PLETKA_PORT:-8080}).
# Default if unset: 3333 (main worktree).
# PLETKA_PORT=3334

# Pletka DB overrides (consumed by internal/domain/config.go WithEnvOverrides).
# Use `make db-clone` to copy pletka_weave into a per-worktree DB.
# PLETKA_DB_HOST=localhost
# PLETKA_DB_PORT=5433
# PLETKA_DB_NAME=pletka_weave_<worktree>
# PLETKA_DB_USER=postgres
# PLETKA_DB_PASSWORD=pw123
# PLETKA_DB_SSLMODE=disable

# Optional log level
# PLETKA_LOG_LEVEL=debug

# Other env vars
# PLETKA_ENV=development
