# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Go build artifacts
/server/cmd/*/cmd
*.prof

# Embedded frontend bundle (regenerated by `make build`).
# Track only the placeholder so `//go:embed` in server/assets/embed.go always
# has something to embed in a fresh clone.
/server/assets/dist/*
!/server/assets/dist/index.html

# Node
/renderer/node_modules/
/renderer/dist/
/renderer/.svelte-kit/
*.tsbuildinfo

# Env / local
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Coverage
coverage.out
coverage.html

# Tooling caches
.golangci-cache/
.goreleaser/

# Local credentials
*.pem
*.key

# Claude Code per-checkout / machine-local settings.
# settings.json is regenerated per worktree by `openwolf init`; tracking
# it would cause conflicts. settings.local.json is per-developer.
.claude/settings.json
.claude/settings.local.json
.claude/.commit-approved-*
.claude/mcp_servers.json

# OpenWolf — shared infra (OPENWOLF.md, config.json, identity.md,
# reframe-frameworks.md, hooks/*.js, hooks/package.json,
# cron-manifest.json) stays tracked. Per-checkout learnings, runtime
# state, and the canonical marker are ignored:
.wolf/.canonical
.wolf/memory.md
.wolf/anatomy.md
.wolf/cerebrum.md
.wolf/buglog.json
.wolf/cron-state.json
.wolf/token-ledger.json
.wolf/suggestions.json
.wolf/designqc-report.json
.wolf/designqc-captures/
.wolf/hooks/_session.json
.wolf/hooks/node_modules/
.wolf/daemon.log
.wolf/*.log
