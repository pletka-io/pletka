# Reviewed user seed file — carries plaintext passwords, never commit
seed-users.yaml
cmd/internal/importconfig/seed-users.yaml

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
# Top-level CLI builds (go build ./cmd/<tool>) drop the binary at repo
# root by default — ignore them so accidental builds don't get staged.
i18n-check

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# Go workspace.
# go.work is TRACKED — it pins the migration wiring (legacy module +
# ./pletka staging tree). When migration ends and ./pletka is dropped
# from the workspace, this file goes away naturally.
# go.work.sum is the derived checksum — not tracked, regenerated on
# demand like go.sum on legacy builds.
go.work.sum

# Air tmp directory
tmp/

# exports
csv_exports
_pocs
weave-stats/

# Database files
data/
_data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sql
*.sql.zst
# Except source-controlled SQL: goose migrations, sqlc query files, and
# one-shot maintenance scripts.
!pkg/database/migrations/*.sql
!pkg/database/queries/*.sql
!pletka/store/migrations/*.sql
!pletka/store/queries/*.sql
!scripts/sql/*.sql

