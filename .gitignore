# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Go build artifacts
/server/cmd/*/cmd
*.prof

# Embedded frontend bundle (regenerated by `make build`).
# Track only the placeholder so `//go:embed` in server/assets/embed.go always
# has something to embed in a fresh clone.
/server/assets/dist/*
!/server/assets/dist/index.html

# Node
/renderer/node_modules/
/renderer/dist/
/renderer/.svelte-kit/
*.tsbuildinfo

# Env / local
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Coverage
coverage.out
coverage.html

# Tooling caches
.golangci-cache/
.goreleaser/

# Local credentials
*.pem
*.key
