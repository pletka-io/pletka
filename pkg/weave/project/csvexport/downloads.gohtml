<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Downloads — {{.ProjectName}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f9fafb;
      color: #111827;
      margin: 0;
      padding: 2rem 1.5rem;
    }
    .wrap { max-width: 64rem; margin: 0 auto; }
    nav.breadcrumb { font-size: 0.875rem; color: #6b7280; margin-bottom: 1.5rem; }
    nav.breadcrumb a { color: #374151; text-decoration: none; }
    nav.breadcrumb a:hover { color: #2563eb; text-decoration: underline; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; gap: 1rem; }
    .header h1 { margin: 0; font-size: 1.5rem; font-weight: 700; }
    .header p { margin: 0.25rem 0 0 0; font-size: 0.875rem; color: #6b7280; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: #059669; color: #fff;
      border-radius: 0.375rem; text-decoration: none;
      font-size: 0.875rem; font-weight: 500;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
    .btn-primary:hover { background: #047857; }
    .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1fr; } }
    .card {
      background: #fff; border: 1px solid #e5e7eb; border-radius: 0.5rem;
      padding: 1.25rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
    }
    .card-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
    .card-info { display: flex; gap: 0.75rem; align-items: flex-start; }
    .card-info svg { flex-shrink: 0; color: #9ca3af; }
    .card h3 { margin: 0; font-size: 0.875rem; font-weight: 600; }
    .card p { margin: 0.25rem 0 0 0; font-size: 0.75rem; color: #6b7280; }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.25rem;
      padding: 0.375rem 0.75rem;
      background: #fff; color: #374151;
      border: 1px solid #d1d5db; border-radius: 0.375rem;
      text-decoration: none;
      font-size: 0.75rem; font-weight: 500;
    }
    .btn-secondary:hover { background: #f9fafb; }
    .back-link {
      display: inline-flex; align-items: center; gap: 0.375rem;
      margin-bottom: 1rem;
      padding: 0.375rem 0.75rem;
      color: #4b5563; background: transparent;
      border: 1px solid #d1d5db; border-radius: 0.375rem;
      text-decoration: none;
      font-size: 0.875rem; font-weight: 500;
    }
    .back-link:hover { background: #f3f4f6; color: #111827; }
    .release-banner {
      margin-bottom: 1rem;
      padding: 0.875rem 1rem;
      border: 1px solid #bfdbfe;
      background: #eff6ff;
      color: #1d4ed8;
      border-radius: 0.5rem;
      font-size: 0.875rem;
    }
    .release-banner strong { font-weight: 600; }
    .release-banner a { color: #1d4ed8; font-weight: 600; text-decoration: underline; }
  </style>
</head>
<body>
  <div class="wrap">
    <a class="back-link" href="{{.ProjectURL}}">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      {{.BackLabel}}
    </a>
    {{if .IsRelease}}
    <div class="release-banner">
      <strong>Viewing release {{.Version}}</strong><br>
      This exports page is showing read-only snapshot data. <a href="/projects/{{.ProjectID}}/exports">Return to draft</a>
    </div>
    {{end}}
    <nav class="breadcrumb">
      <a href="/projects">Projects</a>
      &nbsp;›&nbsp;
      <a href="{{.ProjectURL}}">{{.ProjectName}}</a>
      &nbsp;›&nbsp;
      <span>Downloads</span>
    </nav>

    <div class="header">
      <div>
        <h1>Downloads</h1>
        <p>Export data for {{.ProjectName}} as CSV files.</p>
      </div>
      <a href="{{.ZipURL}}" class="btn-primary">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download All (ZIP)
      </a>
    </div>

    <div class="grid">
      {{range .Exports}}
      <div class="card">
        <div class="card-row">
          <div class="card-info">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{.Icon}}" />
            </svg>
            <div>
              <h3>{{.Name}}</h3>
              <p>{{.Desc}}</p>
            </div>
          </div>
          <a href="{{.URL}}" class="btn-secondary">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            CSV
          </a>
        </div>
      </div>
      {{end}}
    </div>
  </div>
</body>
</html>
