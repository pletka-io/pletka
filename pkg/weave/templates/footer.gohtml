{{define "footer"}}
<footer class="bg-white border-t mt-auto">
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
            <div class="flex space-x-6 text-sm text-gray-500">
                <a href="/about" class="hover:text-gray-700">{{.Labels.NavAbout}}</a>
                <a href="/community" class="hover:text-gray-700">{{.Labels.NavCommunity}}</a>
            </div>
            <div class="flex items-center space-x-4 text-sm text-gray-500">
                <span>{{.Labels.FooterTagline}}</span>
                <div data-island="build-badge"></div>
            </div>
        </div>
        <div class="mt-6 pt-4 border-t border-gray-100 text-xs text-gray-400 text-center">
            &copy; 2026 <a href="https://takin.solutions" target="_blank" rel="noopener" class="hover:text-gray-600">Takin.solutions</a>. Pletka&reg; is a registered trademark of Takin.solutions.
        </div>
    </div>
</footer>
{{islandScripts "build-badge"}}
{{end}}
