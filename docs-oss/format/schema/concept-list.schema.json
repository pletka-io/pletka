{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pletka.io/schema/format/2/concept-list.schema.json",
  "title": "concept-lists/<CL>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_id"
  ],
  "properties": {
    "semantic_id": {
      "$ref": "common.schema.json#/$defs/semanticId"
    },
    "system_name": {
      "type": "string"
    },
    "ui_name": {
      "$ref": "common.schema.json#/$defs/translations"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/translations"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "is_closed": {
      "type": "boolean"
    }
  }
}
