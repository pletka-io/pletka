{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pletka.io/schema/format/2/field.schema.json",
  "title": "fields/<F>/field.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_id"],
  "properties": {
    "_adopted_from": {"$ref": "common.schema.json#/$defs/adoptedFrom"},
    "semantic_id": {"$ref": "common.schema.json#/$defs/semanticId"},
    "system_name": {"type": "string"},
    "ui_name": {"$ref": "common.schema.json#/$defs/translations"},
    "description": {"$ref": "common.schema.json#/$defs/translations"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "deprecated": {"type": "boolean"},
    "ontology_scope": {"$ref": "common.schema.json#/$defs/pathStep"},
    "path_elements": {"$ref": "common.schema.json#/$defs/pathSteps"},
    "ontology_path": {"type": "string", "description": "Derived summary of path_elements, written by the materializer, ignored on load."},
    "expected_value_type": {"type": "string", "description": "Known: String, Date, Integer, URI, GeoJson, Model, Collection, Concept. Open set until data is normalised.", "examples": ["String", "Date", "Integer", "URI", "GeoJson", "Model", "Collection", "Concept"]},
    "subfield_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_elements"],
        "properties": {
          "path_elements": {"$ref": "common.schema.json#/$defs/pathSteps"},
          "expected_value_type": {"type": "string"},
          "scope": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "examples": {"type": "array", "deprecated": true, "description": "Accepted on load, never written."}
  }
}
