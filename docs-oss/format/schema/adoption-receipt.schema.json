{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pletka.io/schema/format/2/adoption-receipt.schema.json",
  "title": "adoptions/<entity_type>-<entity_id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adoption"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id", "source"],
      "properties": {
        "entity_type": {"type": "string", "examples": ["field", "model", "collection", "category", "concept_list"]},
        "entity_id": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "entity_id"],
          "properties": {
            "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
            "entity_id": {"type": "string"},
            "version": {"type": "string", "deprecated": true, "description": "v1 pin; in v2 the source version is what pletka.mod resolves."}
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_entity_type", "context_entity_id"],
            "properties": {
              "context_entity_type": {"type": "string"},
              "context_entity_id": {"type": "string"},
              "adopted_at": {"type": "string"},
              "adopted_by": {"$ref": "common.schema.json#/$defs/actor"}
            }
          }
        }
      }
    }
  }
}
